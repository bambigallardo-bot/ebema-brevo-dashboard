# API key de Brevo (Settings -> SMTP & API -> API Keys). OBLIGATORIA.
BREVO_API_KEY=tu_clave_de_brevo_aqui

# Protección opcional del link. Si las dejas vacías, el dashboard queda ABIERTO.
# DASHBOARD_USER=ebema
# DASHBOARD_PASSWORD=una_clave_segura

# Google Analytics (solo para clics de WhatsApp). Opcional.
# GA4_PROPERTY_ID=123456789

# --- Opción A: OAuth como usuario con acceso a GA (ej. Serena). Sin admin. ---
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxx

# --- Opción B: cuenta de servicio (requiere que un admin de GA le de acceso) ---
# GA_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"..."}

# Opcionales (valores por defecto): metrica de clic y valor del canal WhatsApp.
# GA_CLICK_METRIC=sessions
# GA_WHATSAPP_VALUE=whatsapp
